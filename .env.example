# Safe placeholders only. Copy to .env and replace passwords locally.
APP_NAME="PAWTEL API"
# Explicit local HTTP settings. Production must use HTTPS and Secure cookies.
APP_ENV=development
SESSION_COOKIE_SECURE=false
SESSION_LIFETIME_SECONDS=86400
VERIFICATION_LIFETIME_SECONDS=86400
# Accepted holds remain reserved until explicit cancellation/expiry transition.
BOOKING_PAYMENT_WINDOW_SECONDS=1800
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# The isolated Homebrew PostgreSQL 18 cluster uses 5433 on this Mac.
DATABASE_URL=postgresql+psycopg://pawtel_dev:replace_with_local_password@127.0.0.1:5433/pawtel_dev
TEST_DATABASE_URL=postgresql+psycopg://pawtel_test:replace_with_different_local_password@127.0.0.1:5433/pawtel_test
# URI-encode special characters in passwords. Neither URL is a frontend variable.
# Development startup and /health work without a database; /ready returns 503.
# Production requires secure cookies, HTTPS origins and explicit allowed hosts.
# ALLOWED_HOSTS=["pawtel.example.com"]
DEBUG=false
# E2E_DATABASE_URL points only to a separate local pawtel_e2e database/role.
# Never point E2E at pawtel_dev/pawtel_test or a production database.

# Stripe sandbox/test only. Leave empty until configured; never use live keys.
STRIPE_SECRET_KEY=
# Legacy STRIPE_PUBLISHABLE_KEY is backend validation-only; leave it unset.
# Checkout uses the single VITE_STRIPE_PUBLISHABLE_KEY below.
# The only Stripe key exposed to Vite/browser code; same sandbox as backend.
VITE_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_RETURN_URL=http://localhost:5173/checkout/return

# Optional operator seed/rotation: choose a private 15–128 character passphrase.
# Use ignored .env locally or the provider secret store for the guarded portfolio CLI.
# Normal API authentication does not read this value. Never commit it.
# PAWTEL_DEMO_PASSWORD=

# Cloudinary server-side Listing media. No VITE_ credentials or unsigned preset.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Selected deployment: compiled React and API on the same HTTPS origin.
SERVE_FRONTEND=false
# Enable only on the dedicated synthetic portfolio database.
PORTFOLIO_DEMO=false
# PORTFOLIO_SEED_CONFIRM is an operator CLI acknowledgement, not a browser setting.
