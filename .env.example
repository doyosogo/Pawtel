# Safe placeholders only. Copy to .env and replace passwords locally.
APP_NAME="PAWTEL API"
BACKEND_CORS_ORIGINS=["http://localhost:5173"]

# The isolated Homebrew PostgreSQL 18 cluster uses 5433 on this Mac.
DATABASE_URL=postgresql+psycopg://pawtel_dev:replace_with_local_password@127.0.0.1:5433/pawtel_dev
TEST_DATABASE_URL=postgresql+psycopg://pawtel_test:replace_with_different_local_password@127.0.0.1:5433/pawtel_test
# URI-encode special characters in passwords. Neither URL is a frontend variable.
# Startup and /health also work when DATABASE_URL is unset.
